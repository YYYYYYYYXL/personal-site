---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { profile } from '../data/profile';
const path = Astro.url.pathname;
const links = [{ label: '首页', href: '/' }, { label: '项目', href: '/projects/' }, { label: '笔记', href: '/notes/' }, { label: '关于', href: '/about/' }, { label: '联系', href: '/contact/' }];
---
<a class="skip-link" href="#main-content">跳到主要内容</a>
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="于鑫磊的个人网站首页"><Image class="brand-avatar" src={avatar} alt="" width={44} height={44} densities={[1, 2]} format="webp" loading="eager" /><span class="brand-name">于鑫磊</span></a>
    <button class="menu-toggle" type="button" aria-label="打开导航菜单" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle><Icon name="list" size={24} /><span>菜单</span></button>
    <nav id="primary-navigation" class="primary-navigation" aria-label="主导航" data-navigation>
      {links.map(link => <a href={link.href} aria-current={(link.href === '/' ? path === '/' : path.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>)}
      <a class="nav-github" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub 个人主页，新窗口打开"><Icon name="github-logo" size={20} /><span>GitHub</span></a>
      <a class="nav-resume" href="/resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="查看简历 PDF，新标签页打开">查看简历</a>
    </nav>
  </div>
</header>
