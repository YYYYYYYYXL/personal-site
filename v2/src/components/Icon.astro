---
import iconSet from '@iconify-json/ph/icons.json';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 20, class: className } = Astro.props;
const icons = iconSet.icons as Record<string, { body: string }>;
const icon = icons[name];
---
{icon && <svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${iconSet.width} ${iconSet.height}`} width={size} height={size} class:list={['icon', className]} aria-hidden="true" focusable="false" set:html={icon.body} />}
