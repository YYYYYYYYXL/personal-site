---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'secondary' | 'text'; icon?: string; external?: boolean; class?: string; }
const { href, variant = 'primary', icon = 'arrow-up-right', external = false, class: className } = Astro.props;
---
<a href={href} class:list={['button', `button--${variant}`, className]} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <slot /><Icon name={icon} size={19} />
</a>
