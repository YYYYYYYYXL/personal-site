---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/noto-sans-sc';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = '于鑫磊 · 数据、模型与应用', description = profile.description, noindex = false } = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, profile.site).href;
const pageTransition = {
  forwards: {
    old: { name: 'page-leave', duration: '180ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'page-arrive', duration: '320ms', easing: 'cubic-bezier(.2,.65,.3,1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-leave-back', duration: '180ms', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'page-arrive-back', duration: '320ms', easing: 'cubic-bezier(.2,.65,.3,1)', fillMode: 'both' },
  },
} as const;
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: profile.site, sameAs: [profile.github], affiliation: { '@type': 'CollegeOrUniversity', name: profile.school }, description: profile.description }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080d17" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/xinlei-wenkai.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter fallback="swap" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="于鑫磊的个人空间" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-cover.jpg', profile.site).href} />
    <meta property="og:image:alt" content="于鑫磊个人网站的黑蓝色深夜工作室主题插画" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1" transition:name="page" transition:animate={pageTransition}><slot /></main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
